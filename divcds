<iframe 
  id="rssFrame"
  src="https://triquan221.github.io/rsstrangtt-tpcl/cds.html" 
  width="100%" 
  height="800" 
  style="border:none;" 
  loading="lazy">
</iframe>

<script>
  // Tự động reload iframe sau mỗi 60 phút (3600000 ms)
  setInterval(function() {
    const iframe = document.getElementById('rssFrame');
    if (iframe) {
      iframe.src = iframe.src;
    }
  }, 60 * 60 * 1000); // 60 phút
</script>
